* {
  box-sizing: border-box;
}

.superadmin-layout {
  min-height: 100vh;
  display: flex;
  background: #f8fafc;
  color: #0f172a;
}

.superadmin-sidebar {
  width: 250px;
  min-width: 250px;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  background: #ffffff;
  border-right: 1px solid #e2e8f0;
}

.superadmin-brand {
  height: 82px;
  display: flex;
  align-items: center;
  gap: 11px;
  padding: 0 20px;
  border-bottom: 1px solid #e2e8f0;
}

.superadmin-brand-icon {
  width: 38px;
  height: 38px;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  border-radius: 9px;
  background: #4f46e5;
  color: #ffffff;
}

.superadmin-brand h2 {
  margin: 0;
  color: #0f172a;
  font-size: 15px;
  font-weight: 700;
}

.superadmin-brand p {
  margin: 3px 0 0;
  color: #94a3b8;
  font-size: 10px;
}

.superadmin-nav {
  flex: 1;
  padding: 24px 14px;
}

.superadmin-nav-title {
  margin: 0 10px 10px;
  color: #94a3b8;
  font-size: 9px;
  font-weight: 700;
  letter-spacing: 0.08em;
}

.superadmin-nav-link {
  min-height: 42px;
  display: flex;
  align-items: center;
  gap: 11px;
  margin-bottom: 4px;
  padding: 0 12px;
  border-radius: 8px;
  color: #64748b;
  text-decoration: none;
  font-size: 12px;
  font-weight: 500;
  transition: 0.15s ease;
}

.superadmin-nav-link svg {
  flex-shrink: 0;
}

.superadmin-nav-link:hover {
  background: #f8fafc;
  color: #334155;
}

.superadmin-nav-link.active {
  background: #eef2ff;
  color: #4f46e5;
  font-weight: 600;
}

.superadmin-sidebar-bottom {
  padding: 15px 14px;
  border-top: 1px solid #e2e8f0;
}

.superadmin-logout {
  width: 100%;
  height: 42px;
  display: flex;
  align-items: center;
  gap: 11px;
  padding: 0 12px;
  border: none;
  border-radius: 8px;
  background: transparent;
  color: #64748b;
  font-size: 12px;
  cursor: pointer;
}

.superadmin-logout:hover {
  background: #fef2f2;
  color: #dc2626;
}

.superadmin-main {
  flex: 1;
  min-width: 0;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
}

.superadmin-header {
  min-height: 82px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
  padding: 0 30px;
  background: #ffffff;
  border-bottom: 1px solid #e2e8f0;
}

.superadmin-header-label {
  margin: 0 0 4px;
  color: #94a3b8;
  font-size: 9px;
  font-weight: 700;
  letter-spacing: 0.08em;
}

.superadmin-header h1 {
  margin: 0;
  color: #0f172a;
  font-size: 18px;
  font-weight: 700;
}

.superadmin-profile {
  display: flex;
  align-items: center;
  gap: 10px;
}

.superadmin-avatar {
  width: 38px;
  height: 38px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #eef2ff;
  color: #4f46e5;
  font-size: 12px;
  font-weight: 700;
}

.superadmin-profile-name {
  margin: 0 0 2px;
  color: #0f172a;
  font-size: 12px;
  font-weight: 600;
}

.superadmin-profile-role {
  margin: 0;
  color: #94a3b8;
  font-size: 10px;
}

.superadmin-content {
  flex: 1;
  padding: 30px;
}

/* Dashboard */

.dashboard-page {
  width: 100%;
}

.dashboard-heading {
  margin-bottom: 24px;
}

.dashboard-eyebrow {
  margin: 0 0 5px;
  color: #94a3b8;
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 0.08em;
}

.dashboard-heading h2 {
  margin: 0;
  color: #0f172a;
  font-size: 25px;
  font-weight: 700;
}

.dashboard-heading p {
  margin: 7px 0 0;
  color: #64748b;
  font-size: 14px;
}

.dashboard-stats {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 16px;
  margin-bottom: 22px;
}

.dashboard-stat-card {
  min-height: 115px;
  padding: 18px;
  background: #ffffff;
  border: 1px solid #e2e8f0;
  border-radius: 11px;
}

.dashboard-stat-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.dashboard-stat-icon {
  width: 38px;
  height: 38px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 9px;
  background: #eef2ff;
  color: #4f46e5;
}

.dashboard-stat-card span {
  display: block;
  margin-top: 15px;
  color: #64748b;
  font-size: 12px;
}

.dashboard-stat-card strong {
  display: block;
  margin-top: 3px;
  color: #0f172a;
  font-size: 23px;
}

/* Users */

.users-page {
  width: 100%;
}

.users-heading {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20px;
  margin-bottom: 26px;
}

.users-eyebrow {
  margin: 0 0 5px;
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 0.08em;
  color: #94a3b8;
}

.users-heading h2 {
  margin: 0;
  font-size: 25px;
  font-weight: 700;
  color: #0f172a;
}

.users-heading p:last-child {
  margin: 7px 0 0;
  font-size: 14px;
  color: #64748b;
}

.users-add-button {
  display: flex;
  align-items: center;
  gap: 8px;
  min-height: 42px;
  padding: 0 16px;
  border: none;
  border-radius: 8px;
  background: #4f46e5;
  color: #ffffff;
  font-size: 13px;
  font-weight: 600;
  cursor: pointer;
}

.users-add-button:hover {
  background: #4338ca;
}

.users-summary {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 16px;
  margin-bottom: 22px;
}

.users-summary-card {
  display: flex;
  align-items: center;
  gap: 13px;
  min-height: 88px;
  padding: 17px;
  background: #ffffff;
  border: 1px solid #e2e8f0;
  border-radius: 11px;
}

.users-summary-icon {
  width: 38px;
  height: 38px;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  border-radius: 9px;
  background: #eef2ff;
  color: #4f46e5;
}

.users-summary-card span {
  display: block;
  margin-bottom: 3px;
  font-size: 12px;
  color: #64748b;
}

.users-summary-card strong {
  font-size: 20px;
  color: #0f172a;
}

.users-panel {
  background: #ffffff;
  border: 1px solid #e2e8f0;
  border-radius: 12px;
  overflow: hidden;
}

.users-toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 15px;
  padding: 18px 20px;
  border-bottom: 1px solid #e2e8f0;
}

.users-search {
  width: 300px;
  height: 40px;
  display: flex;
  align-items: center;
  gap: 9px;
  padding: 0 12px;
  border: 1px solid #e2e8f0;
  border-radius: 8px;
  color: #94a3b8;
}

.users-search input {
  width: 100%;
  border: none;
  outline: none;
  background: transparent;
  color: #334155;
  font-size: 13px;
}

.users-search input::placeholder {
  color: #94a3b8;
}

.users-filters {
  display: flex;
  align-items: center;
  gap: 10px;
}

.users-filter,
.users-status-filter {
  height: 40px;
  display: flex;
  align-items: center;
  gap: 7px;
  padding: 0 11px;
  border: 1px solid #e2e8f0;
  border-radius: 8px;
  background: #ffffff;
  color: #64748b;
  font-size: 12px;
}

.users-filter select,
.users-status-filter {
  outline: none;
  cursor: pointer;
}

.users-filter select {
  border: none;
  background: transparent;
  color: #475569;
  font-size: 12px;
}

.users-table-wrapper {
  width: 100%;
  overflow-x: auto;
}

.users-table {
  width: 100%;
  border-collapse: collapse;
  min-width: 720px;
}

.users-table th {
  padding: 13px 20px;
  background: #f8fafc;
  border-bottom: 1px solid #e2e8f0;
  color: #64748b;
  font-size: 11px;
  font-weight: 700;
  text-align: left;
  text-transform: uppercase;
  letter-spacing: 0.04em;
}

.users-table td {
  padding: 15px 20px;
  border-bottom: 1px solid #f1f5f9;
  color: #475569;
  font-size: 13px;
}

.users-table tbody tr:hover {
  background: #fafbff;
}

.user-info {
  display: flex;
  align-items: center;
  gap: 11px;
}

.user-avatar {
  width: 38px;
  height: 38px;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  border-radius: 50%;
  background: #eef2ff;
  color: #4f46e5;
  font-size: 13px;
  font-weight: 700;
}

.user-info strong {
  display: block;
  margin-bottom: 3px;
  color: #0f172a;
  font-size: 13px;
  font-weight: 600;
}

.user-info span {
  display: block;
  color: #94a3b8;
  font-size: 11px;
}

.user-role {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  font-size: 12px;
  font-weight: 600;
}

.role-admin {
  color: #7c3aed;
}

.role-mentor {
  color: #0369a1;
}

.role-student {
  color: #047857;
}

.user-status {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  font-size: 12px;
  font-weight: 500;
}

.user-status > span {
  width: 6px;
  height: 6px;
  border-radius: 50%;
}

.status-active {
  color: #047857;
}

.status-active > span {
  background: #10b981;
}

.status-pending {
  color: #b45309;
}

.status-pending > span {
  background: #f59e0b;
}

.status-inactive {
  color: #64748b;
}

.status-inactive > span {
  background: #94a3b8;
}

.user-action-button {
  width: 34px;
  height: 34px;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  border-radius: 7px;
  background: transparent;
  color: #94a3b8;
  cursor: pointer;
}

.user-action-button:hover {
  background: #f1f5f9;
  color: #475569;
}

.users-empty {
  padding: 45px 20px;
  text-align: center;
  color: #94a3b8;
}

.users-pagination {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 15px;
  padding: 15px 20px;
  color: #94a3b8;
  font-size: 12px;
}

.users-pagination div {
  display: flex;
  align-items: center;
  gap: 5px;
}

.users-pagination button {
  min-width: 34px;
  height: 32px;
  padding: 0 9px;
  border: 1px solid #e2e8f0;
  border-radius: 6px;
  background: #ffffff;
  color: #64748b;
  font-size: 11px;
  cursor: pointer;
}

.users-pagination button.active {
  background: #4f46e5;
  border-color: #4f46e5;
  color: #ffffff;
}

.users-pagination button:disabled {
  opacity: 0.5;
  cursor: not-allowed;
}

/* Registrations */

.registrations-page {
  width: 100%;
}

.registrations-heading {
  margin-bottom: 26px;
}

.registrations-eyebrow {
  margin: 0 0 5px;
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 0.08em;
  color: #94a3b8;
}

.registrations-heading h2 {
  margin: 0;
  font-size: 25px;
  font-weight: 700;
  color: #0f172a;
}

.registrations-heading p:last-child {
  margin: 7px 0 0;
  font-size: 14px;
  color: #64748b;
}

.registration-stats {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 16px;
  margin-bottom: 22px;
}

.registration-stat {
  display: flex;
  align-items: center;
  gap: 13px;
  min-height: 88px;
  padding: 17px;
  background: #ffffff;
  border: 1px solid #e2e8f0;
  border-radius: 11px;
}

.registration-stat-icon {
  width: 38px;
  height: 38px;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  border-radius: 9px;
  background: #eef2ff;
  color: #4f46e5;
}

.registration-stat span {
  display: block;
  margin-bottom: 3px;
  font-size: 12px;
  color: #64748b;
}

.registration-stat strong {
  font-size: 20px;
  color: #0f172a;
}

.registration-panel {
  background: #ffffff;
  border: 1px solid #e2e8f0;
  border-radius: 12px;
  overflow: hidden;
}

.registration-tabs {
  display: flex;
  align-items: center;
  gap: 4px;
  padding: 14px 20px 0;
  border-bottom: 1px solid #e2e8f0;
  overflow-x: auto;
}

.registration-tabs button {
  padding: 11px 13px;
  border: none;
  border-bottom: 2px solid transparent;
  background: transparent;
  color: #64748b;
  font-size: 12px;
  font-weight: 500;
  white-space: nowrap;
  cursor: pointer;
}

.registration-tabs button:hover {
  color: #4f46e5;
}

.registration-tabs button.active {
  border-bottom-color: #4f46e5;
  color: #4f46e5;
  font-weight: 600;
}

.registration-toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 15px;
  padding: 18px 20px;
}

.registration-search {
  width: 320px;
  height: 40px;
  display: flex;
  align-items: center;
  gap: 9px;
  padding: 0 12px;
  border: 1px solid #e2e8f0;
  border-radius: 8px;
  color: #94a3b8;
}

.registration-search input {
  width: 100%;
  border: none;
  outline: none;
  background: transparent;
  color: #334155;
  font-size: 13px;
}

.registration-search input::placeholder {
  color: #94a3b8;
}

.registration-filter-button {
  height: 40px;
  display: flex;
  align-items: center;
  gap: 7px;
  padding: 0 13px;
  border: 1px solid #e2e8f0;
  border-radius: 8px;
  background: #ffffff;
  color: #64748b;
  font-size: 12px;
  cursor: pointer;
}

.registration-table-wrapper {
  width: 100%;
  overflow-x: auto;
}

.registration-table {
  width: 100%;
  min-width: 850px;
  border-collapse: collapse;
}

.registration-table th {
  padding: 13px 20px;
  background: #f8fafc;
  border-bottom: 1px solid #e2e8f0;
  color: #64748b;
  font-size: 11px;
  font-weight: 700;
  text-align: left;
  text-transform: uppercase;
}

.registration-table td {
  padding: 15px 20px;
  border-bottom: 1px solid #f1f5f9;
  color: #475569;
  font-size: 13px;
}

.registration-table tbody tr:hover {
  background: #fafbff;
}

.application-user {
  display: flex;
  align-items: center;
  gap: 11px;
}

.application-avatar {
  width: 38px;
  height: 38px;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  border-radius: 50%;
  background: #eef2ff;
  color: #4f46e5;
  font-size: 13px;
  font-weight: 700;
}

.application-user strong {
  display: block;
  margin-bottom: 3px;
  color: #0f172a;
  font-size: 13px;
}

.application-user span {
  display: block;
  color: #94a3b8;
  font-size: 11px;
}

.registration-status {
  display: inline-flex;
  align-items: center;
  min-height: 26px;
  padding: 0 9px;
  border-radius: 20px;
  font-size: 11px;
  font-weight: 600;
}

.status-submitted {
  background: #f1f5f9;
  color: #475569;
}

.status-shortlisted {
  background: #eff6ff;
  color: #2563eb;
}

.status-interviewed {
  background: #f5f3ff;
  color: #7c3aed;
}

.status-accepted {
  background: #ecfdf5;
  color: #047857;
}

.status-rejected {
  background: #fef2f2;
  color: #dc2626;
}

.registration-action {
  width: 34px;
  height: 34px;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  border-radius: 7px;
  background: transparent;
  color: #94a3b8;
  cursor: pointer;
}

.registration-empty {
  padding: 45px 20px;
  text-align: center;
  color: #94a3b8;
}

.registration-pagination {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 15px 20px;
  color: #94a3b8;
  font-size: 12px;
}

.registration-pagination div {
  display: flex;
  gap: 5px;
}

.registration-pagination button {
  min-width: 34px;
  height: 32px;
  padding: 0 9px;
  border: 1px solid #e2e8f0;
  border-radius: 6px;
  background: #ffffff;
  color: #64748b;
  font-size: 11px;
}

.registration-pagination button.active {
  background: #4f46e5;
  border-color: #4f46e5;
  color: #ffffff;
}

.registration-pagination button:disabled {
  opacity: 0.5;
}

/* Responsive */

@media (max-width: 1100px) {
  .superadmin-sidebar {
    width: 220px;
    min-width: 220px;
  }

  .superadmin-content {
    padding: 24px;
  }

  .dashboard-stats,
  .users-summary,
  .registration-stats {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

@media (max-width: 760px) {
  .superadmin-layout {
    display: block;
  }

  .superadmin-sidebar {
    width: 100%;
    min-width: 100%;
    min-height: auto;
  }

  .superadmin-brand {
    height: 70px;
  }

  .superadmin-nav {
    padding: 12px;
  }

  .superadmin-nav-link {
    display: inline-flex;
    width: auto;
    margin-right: 4px;
  }

  .superadmin-nav-title {
    display: none;
  }

  .superadmin-sidebar-bottom {
    display: none;
  }

  .superadmin-header {
    min-height: 70px;
    padding: 0 20px;
  }

  .superadmin-content {
    padding: 20px;
  }

  .dashboard-stats,
  .users-summary,
  .registration-stats {
    grid-template-columns: 1fr;
  }

  .users-heading {
    flex-direction: column;
  }

  .users-add-button {
    width: 100%;
    justify-content: center;
  }

  .users-toolbar,
  .registration-toolbar {
    align-items: stretch;
    flex-direction: column;
  }

  .users-search,
  .registration-search {
    width: 100%;
  }

  .users-filters {
    flex-direction: column;
    align-items: stretch;
  }

  .users-filter,
  .users-status-filter {
    width: 100%;
  }

  .registration-filter-button {
    align-self: flex-start;
  }

  .users-pagination,
  .registration-pagination {
    align-items: flex-start;
    flex-direction: column;
  }
}